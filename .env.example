# SSIM Discord Bot: environment
#
# Copy this file to .env and fill it in. NEVER commit .env.
#
# To copy an ID, turn on Developer Mode in Discord (User Settings, Advanced),
# then right-click the server, channel, or role and choose Copy ID.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Discord application: https://discord.com/developers/applications
# The token is a password. Anyone holding it controls the bot.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# The server the bot runs in. Commands register per guild, so they appear instantly.
GUILD_ID=

# Channel where /panel posts the ticket panel.
ONBOARDING_CHANNEL_ID=

# A CATEGORY, not a text channel. New ticket channels are created under it.
TICKET_CATEGORY_ID=

# Role that gates every staff command and the ticket claim button.
STAFF_ROLE_ID=

# ---------------------------------------------------------------------------
# Announcements and downloads
# ---------------------------------------------------------------------------

# Preferred way to post releases: a webhook created in the announcements channel,
# so posts carry your project's name and avatar instead of the bot's.
# Without it, the bot posts as itself in ANNOUNCE_CHANNEL_ID. Set one or the other.
ANNOUNCE_WEBHOOK_URL=
ANNOUNCE_CHANNEL_ID=

# Channel holding the single downloads message, which is edited in place on every
# release. Leave empty to skip it.
DOWNLOADS_CHANNEL_ID=

# Fixed link behind the "Full install" button. The per-version button is filled in
# automatically from the release assets. Leave empty to show only that one.
DOWNLOAD_ZIP_URL=

# The owner/repo the release watcher reads. Public repository, no token needed.
GITHUB_REPO=Santerxyz/SSIM

# Release poll interval in milliseconds. 600000 is 10 minutes. Values below 60000
# are clamped. This is the safety net that catches any missed push.
POLL_INTERVAL_MS=600000

# ---------------------------------------------------------------------------
# Push endpoint
# ---------------------------------------------------------------------------

# Shared secret for POST /internal/announce. A publisher signs the request body with
# HMAC-SHA256 under this key and sends it as "X-SSIM-Signature: sha256=<hex>".
# Leave it empty and the endpoint refuses every request; the poller still works.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANNOUNCE_HMAC_SECRET=

# Local HTTP server carrying /internal/announce and /health.
HTTP_PORT=8787

# Bind address. Use 127.0.0.1 unless something off-machine must reach the endpoint,
# and put a reverse proxy with TLS in front if it does. 0.0.0.0 listens everywhere.
HTTP_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Staff-only channel mirroring ticket opens, claims, and closes.
AUDIT_CHANNEL_ID=

# Staff-only channel that receives an HTML transcript when a ticket closes.
TICKET_LOG_CHANNEL_ID=

# Hours of silence before a ticket is warned and then closed two hours later.
# 0 disables auto-close.
TICKET_AUTOCLOSE_HOURS=0

# Where state.json is written. Defaults to ./data beside the working directory.
# DATA_DIR=
