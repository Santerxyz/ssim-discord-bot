{
  "name": "ssim-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot for the SSIM community server: release announcements, a self-updating downloads channel, and support tickets",
  "license": "Apache-2.0",
  "author": "Santer.xyz",
  "homepage": "https://github.com/Santerxyz/ssim-discord-bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santerxyz/ssim-discord-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Santerxyz/ssim-discord-bot/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/index.ts --register-only",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
