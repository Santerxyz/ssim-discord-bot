# ── SSIM Discord Bot — environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. (Enable Developer Mode in Discord to
# copy IDs: User Settings → Advanced → Developer Mode, then right-click → Copy ID.)

# Discord application (https://discord.com/developers/applications → your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Channels (right-click the channel → Copy Channel ID)
ANNOUNCE_CHANNEL_ID=
ONBOARDING_CHANNEL_ID=
TICKET_CATEGORY_ID=
AUDIT_CHANNEL_ID=
TICKET_LOG_CHANNEL_ID=

# Roles (right-click the role in Server Settings → Roles is not copyable; use Copy ID
# on a member's role chip, or the role's context menu with Developer Mode on)
STAFF_ROLE_ID=
BETA_TESTER_ROLE_ID=

# Announce webhook — create it IN the announce channel, name it "Santer", set the Santer
# avatar. The bot posts releases through this so they render pixel-identically.
ANNOUNCE_WEBHOOK_URL=

# License server (sibling repo ssim-license-server)
LICENSE_API_URL=https://license.ssim.dev
BOT_API_TOKEN=

# Shared HMAC secret with build/publish.js — MUST match secrets.local.bat's
# ANNOUNCE_HMAC_SECRET. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANNOUNCE_HMAC_SECRET=

# Local HTTP server that receives the publish → announce trigger (POST /internal/announce)
HTTP_PORT=8787
# Bind address for that server (127.0.0.1 if behind a reverse proxy on the same host)
HTTP_HOST=0.0.0.0

# /version poll reconciler interval (ms). 600000 = 10 min. Catches any missed push.
POLL_INTERVAL_MS=600000

# Optional ticket inactivity auto-close (hours). 0 = disabled.
TICKET_AUTOCLOSE_HOURS=0
